# Local configuration and secrets. Keep sanitized templates reviewable.
.env
.env.*
!.env.example
!.env.*.example
*.local
secrets/
credentials/
.aws/
.ssh/
.npmrc
.pypirc
*.pem
*.key
*.p12
*.pfx
credentials*.json
service-account*.json
service_account*.json

# Python environments, packaging and tool caches.
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# JavaScript dependencies, builds and browser-test output.
node_modules/
.npm/
.vite/
*.tsbuildinfo
coverage/
playwright-report/
test-results/
blob-report/
dist/
build/

# Runtime data: never track actual project storage.
/storage/**
!/storage/README.md
pgdata/
postgres-data/
redis-data/
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite3-*
*.rdb
*.aof
*.dump
*.backup

# Uploaded tabular data and derived data, wherever accidentally saved.
/uploads/
/datasets/
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.parquet
*.arrow
*.feather

# Trained models and model downloads.
*.pkl
*.pickle
*.joblib
