# Phase 1 local configuration. Setup generates independent secrets in .env.
# Optional: copy to E:\FSI\.env for local overrides; never commit populated secrets.
# Single quotes preserve Windows backslashes in dotenv-compatible parsers.
APP_ENV=development
INFRASTRUCTURE_ENABLED=false
PROJECT_ROOT='E:\FSI'
FILE_STORAGE_ROOT='E:\FSI\storage\artifacts'
WORKER_FILE_STORAGE_ROOT=/app/storage/artifacts

# Proposed endpoints; startup must recheck port availability.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
# Browser calls are relative; Vite proxies /api/v1 to this local API target.
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://127.0.0.1:8000
CORS_ORIGINS='["http://127.0.0.1:5173","http://localhost:5173"]'

# Dedicated infrastructure. Setup enables it after creating local secrets.
COMPOSE_PROJECT_NAME=autoinsight
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=autoinsight
POSTGRES_USER=autoinsight
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
AUTH_CSRF_SECRET=
SESSION_HOURS=24
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

# Reserved legacy URL keys; current clients construct connections from component settings.
# Host connections use localhost ports; worker connections use service DNS.
DATABASE_URL=
REDIS_URL=
WORKER_DATABASE_URL=
WORKER_REDIS_URL=
RQ_QUEUE=autoinsight
RQ_SERIALIZER=json

# Existing Ollama installation; this template does not change server settings.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b-q4_K_M
OLLAMA_MODELS='D:\OllamaModels'
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.0
OLLAMA_MAX_OUTPUT_TOKENS=1200
LLM_CONTEXT_TOKENS=4096
LLM_THINKING=false
MAX_CONCURRENT_LLM_REQUESTS=1

# Later-phase budgets: defaults, not measured capacity.
MAX_UPLOAD_BYTES=25000000
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=100
MAX_AGENT_STEPS=12
MAX_REPLAN_CYCLES=1
MAX_CONCURRENT_ML_JOBS=1
# Phase 1 enforces the queue timeout; other budgets await their feature phases.
MAX_JOB_SECONDS=900

# Local Phase 8 embedding and bounded document processing settings.
RAG_EMBEDDING_MODEL=all-minilm:22m
RAG_EMBEDDING_DIMENSIONS=384
MAX_DOCUMENT_BYTES=25000000
MAX_DOCUMENT_TEXT_BYTES=5000000
MAX_DOCUMENT_PAGES=500
DOCUMENT_CHUNK_CHARS=800
DOCUMENT_CHUNK_OVERLAP=120
DOCUMENT_EMBED_BATCH_SIZE=8
